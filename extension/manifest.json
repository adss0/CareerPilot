{
  "manifest_version": 3,
  "name": "Save to CareerPilot",
  "version": "1.0.0",
  "description": "Save the job you're looking at to your CareerPilot tracker in one click.",
  "action": {
    "default_title": "Save this job to CareerPilot",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/64.png" }
  },
  "icons": { "16": "icons/32.png", "48": "icons/64.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://127.0.0.1:8000/*"]
}
