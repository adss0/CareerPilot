# Default AI provider: gemini | groq | ollama (can be changed in the app's Settings page)
AI_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
# Note: on Google's free tier, prompts may be used to improve Google's products.
GEMINI_API_KEY=
# Model name; the "-latest" alias always points at the newest Flash model
GEMINI_MODEL=gemini-3-flash-preview
# Tried in order when the main model is busy or retired
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite
# Optional: free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: local Ollama server (https://ollama.com), fully offline
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Seconds to wait between AI calls when writing many letters (free-tier rate limits)
AI_REQUEST_GAP_SECONDS=4

# Email password for sending (SMTP) and reading replies (IMAP).
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here. Never your normal password.
EMAIL_PASSWORD=

# Local SQLite database file
DB_PATH=careerpilot.db
# Folder for private files such as uploaded CVs (git-ignored)
DATA_DIR=data

# Frontend dev server origin(s), comma separated
CORS_ORIGINS=http://localhost:5173
