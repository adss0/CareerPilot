# Which AI provider to use: gemini | groq | ollama
AI_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
# Note: on Google's free tier, prompts may be used to improve Google's products.
GEMINI_API_KEY=
# Model name; the "-latest" alias always points at the newest Flash model
GEMINI_MODEL=gemini-flash-latest
# Optional: free key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Local SQLite database file
DB_PATH=careerpilot.db
# Folder for private files such as uploaded CVs (git-ignored)
DATA_DIR=data

# Frontend dev server origin(s), comma separated
CORS_ORIGINS=http://localhost:5173
