{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerPilot",
  "version": "1.1.0",
  "identifier": "app.careerpilot.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CareerPilot",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "CareerPilot",
    "shortDescription": "AI job-application assistant",
    "longDescription": "Imports jobs from Excel, writes tailored cover letters with free AI, sends approved applications and tracks replies.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/careerpilot-server"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
